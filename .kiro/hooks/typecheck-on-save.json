{
  "version": "v1",
  "hooks": [
    {
      "name": "typecheck-on-save",
      "description": "Type checks the project after any TypeScript file is saved.",
      "trigger": "PostFileSave",
      "matcher": "\\.(ts|tsx)$",
      "action": { "type": "command", "command": "bash scripts/hooks/typecheck.sh" },
      "timeout": 120,
      "enabled": true
    }
  ]
}
