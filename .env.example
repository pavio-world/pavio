# Copy to .env.local and fill in. Never commit real values.

# Supabase (publishable key is safe in the browser; RLS protects data)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Direct Postgres connection to the pavio project, for property tests only.
# Never point this at pavio-prod.
SUPABASE_DB_URL=

# Server only. Bypasses RLS. Used ONLY by src/lib/supabase/admin.ts and supabase/seed/
SUPABASE_SECRET_KEY=

# AI provider (server only)
AI_API_KEY=
AI_MONTHLY_SPEND_CAP_USD=10

# Last.fm (server only, built last)
LASTFM_API_KEY=

NEXT_PUBLIC_SITE_URL=http://localhost:3000
